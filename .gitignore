index.html.copy
*.copy
*.copy.*

# 로컬 환경
.env
.env.local
.vscode/
.idea/

# Python 스크립트 작업 임시 (혹시 리포에 흘러들어올 경우)
__pycache__/
*.pyc

# 백엔드 시크릿 (절대 커밋 금지)
**/sa_key.json
*_token*.txt
*api*key*.txt

# 빌드 산출물 (이 리포는 정적 — 빌드 없음, 안전망)
node_modules/
dist/
build/

# 참고자료(2차 설계 산출물·디자인 PDF 등) — 용량이 커서 git 추적 제외. Dropbox 로 공유됨.
